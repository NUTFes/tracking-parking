# プロジェクトパス
HOME_DIR=/Users/ycn/Workspace/NUTMEG/tracking-parking

# YOLOモデル
MODEL_PATH=${HOME_DIR}/models/yolov8s.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.7
VEHICLE_CLASSES=2,7

# 速度計測条件
YOLO_DEVICE=cpu
YOLO_IMGSZ=640
YOLO_TRACKER=botsort.yaml
WARMUP_FRAMES=30
EXP_DEVICE_NAME=raspi5
EXP_DEVICE_ACCELERATOR=cpu

# Line1設定(入口側ライン) - scripts/setup_lines.pyで自動設定
LINE1_START_X=300
LINE1_START_Y=400
LINE1_END_X=800
LINE1_END_Y=400

# Line2設定(駐車場側ライン) - scripts/setup_lines.pyで自動設定
LINE2_START_X=300
LINE2_START_Y=200
LINE2_END_X=800
LINE2_END_Y=200

# 駐車場基準点(駐車場側を定義) - scripts/setup_lines.pyで自動設定
PARKING_REF_X=550
PARKING_REF_Y=100

# 検知パラメータ
MARGIN_PX=5.0               # 判定保留帯の半幅(px)。3cスイープ採用値
ENDPOINT_MARGIN_PX=0.0      # 有限線分判定の端点許容量(px)。Phase 3の既定(変更しない)
MAX_FRAME_GAP_SEC=3.0      # Line1とLine2の通過を対応付ける最大の時間差(秒)
CLEANUP_THRESHOLD_SEC=5.0  # 古い追跡をクリーンアップするまでの未更新時間(秒)

# カメラ入力の解像度（動画ファイル入力では使わない）
# 未設定だとデバイス既定で開く。Logitech C270は既定640x480で、1280x720を
# 出せるのに使われない。ライン座標は設定時の画角に紐づくため、実行時の解像度が
# 違うと検知位置がずれる。実機では明示指定すること。
# FOURCCを分けているのは、解像度だけ指定しても通らない組み合わせがあるため
# （C270のYUYVは640x480までで、1280x720はMJPGでしか出ない）。
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FOURCC=MJPG

# 処理方式: hybrid固定
METHOD=hybrid

# 出力設定
SAVE_VIDEO=true
SAVE_LOGS=true
SHOW_DISPLAY=false

# 録画のエンコーダ: auto | nvenc | cv2
# autoはNVENCが使えれば使い、無ければCPUへ落ちる。JetsonのNVENCは
# 1280x720で約5.3ms/フレームに対し、CPU(mp4v)は約11.6ms掛かる。
# nvenc指定でNVENCが無い場合はエラーにする（遅い経路を速いつもりで
# 走り続けるのを防ぐため）。
VIDEO_ENCODER=auto

# 録画を何MBごとに分けるか。0で分割しない。
# mp4のインデックス(moov atom)は終了時に書かれるため、分割しないまま
# プロセスが落ちるとそれまでの全録画が再生不能になる。
# 時間ではなくサイズ基準なのは、書き出しfpsが実効fpsと一致しないため。
VIDEO_SEGMENT_MB=256

# 残すセグメント数。0で無制限（古いものを消さない）。
# 1以上にするとファイル名が循環するため、時系列はmtimeか
# フレームへ焼き込んだJSTから判断すること。
VIDEO_MAX_SEGMENTS=0

# W&B（実機では offline を推奨）
USE_WANDB=false
WANDB_PROJECT=tracking-parking
WANDB_MODE=offline
LOG_INTERVAL_SEC=5

# API送信（tracking-parking-apiへの入出庫イベント送信）
API_ENABLED=false                                    # カメラ入力かつtrueのときだけ送信する（ファイル入力では常に無効）
API_BASE_URL=                                        # 例: http://localhost:8000/api/v1
DEVICE_API_KEY=                                       # デバイス登録時に一度だけ返る平文キー
API_CONNECT_TIMEOUT_SEC=3.0                          # 接続確立の待ち時間
API_READ_TIMEOUT_SEC=5.0                             # 応答の待ち時間
HEARTBEAT_INTERVAL_SEC=30                            # サーバーのオフライン判定(既定120秒)の4分の1
SHUTDOWN_FLUSH_SEC=10                                # 終了時にキューが空になるのを待つ上限(秒)
SPOOL_PATH=data/outputs/unsent_events.jsonl          # 送れなかったイベントの置き場所(相対パスはHOME_DIR基準)
