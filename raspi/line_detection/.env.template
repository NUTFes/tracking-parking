# プロジェクトパス
HOME_DIR=/Users/ycn/Workspace/NUTMEG/tracking-parking

# YOLOモデル
MODEL_PATH=${HOME_DIR}/yolo_fine_tuning/runs/detect/train14/weights/best.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.7
VEHICLE_CLASSES=2,7

# 速度比較条件（ROI方式と同じ値に揃える）
YOLO_DEVICE=cpu
YOLO_IMGSZ=640
YOLO_TRACKER=botsort.yaml
WARMUP_FRAMES=30
EXP_DEVICE_NAME=raspi5
EXP_DEVICE_ACCELERATOR=cpu

# Line1設定(入口側ライン) - setup/setup_lines.pyで自動設定
LINE1_START_X=300
LINE1_START_Y=400
LINE1_END_X=800
LINE1_END_Y=400

# Line2設定(駐車場側ライン) - setup/setup_lines.pyで自動設定
LINE2_START_X=300
LINE2_START_Y=200
LINE2_END_X=800
LINE2_END_Y=200

# 駐車場基準点(駐車場側を定義) - setup/setup_lines.pyで自動設定
PARKING_REF_X=550
PARKING_REF_Y=100

# 検知パラメータ
MARGIN_PX=5.0               # 判定保留帯の半幅(px)。3cスイープ採用値
ENDPOINT_MARGIN_PX=0.0      # 有限線分判定の端点許容量(px)。Phase 3の既定(変更しない)
MAX_FRAME_GAP=90           # 3秒@30fps
CLEANUP_THRESHOLD=150      # 5秒@30fps

# 処理方式: hybrid固定
METHOD=hybrid

# 出力設定
SAVE_VIDEO=true
SAVE_LOGS=true
SHOW_DISPLAY=false

# W&B（実機では offline を推奨）
USE_WANDB=false
WANDB_PROJECT=tracking-parking
WANDB_MODE=offline
LOG_INTERVAL_SEC=5
